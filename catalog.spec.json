{
  "$schema": "https://raw.githubusercontent.com/yschimke/compose-ai-tools/main/scripts/design-artifacts/catalog.spec.schema.json",
  "$comment": "Product-facing Thunderbird catalog rendered from the Android message-list feature. These are the real inbox, search, selection, loading, responsive-layout, density, and archive-folder states used by Thunderbird rather than the four-theme Bolt component specimens.",
  "system": "thunderbird",
  "title": "Thunderbird for Android",
  "library": [
    "Thunderbird Bolt",
    "AndroidX Compose Material 3"
  ],
  "module": ":feature:mail:message:list:internal",
  "modes": [
    "light",
    "dark"
  ],
  "breakpoints": [
    {
      "size": "phone",
      "widthDp": 411,
      "device": "spec:width=411dp,height=891dp,dpi=420"
    },
    {
      "size": "tabletLandscape",
      "widthDp": 1280,
      "device": "spec:width=1280dp,height=800dp,dpi=240"
    }
  ],
  "display": {
    "surface": "light",
    "hero": "Inbox/Loaded"
  },
  "groupOrder": [
    "Inbox states",
    "Responsive layouts",
    "Preferences",
    "Dialogs"
  ],
  "groups": [
    {
      "name": "Inbox states",
      "section": "Screens",
      "components": [
        {
          "componentId": "Inbox/Loaded",
          "preview": "ThunderbirdInboxLoadedCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "The real message list with empty, sent, conversation, active-message, and multi-account preview data."
        },
        {
          "componentId": "Inbox/Searching",
          "preview": "ThunderbirdInboxSearchingCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "Local search, server search, and no-results states."
        },
        {
          "componentId": "Inbox/Selecting",
          "preview": "ThunderbirdInboxSelectingCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "Message selection mode with multiple selected messages."
        },
        {
          "componentId": "Inbox/Loading",
          "preview": "ThunderbirdInboxLoadingCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "Initial, progress, pull-to-refresh, and remote-loading states."
        },
        {
          "componentId": "Inbox/Warming up",
          "preview": "ThunderbirdInboxWarmingUpCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "The startup state before the local message list is ready."
        }
      ]
    },
    {
      "name": "Responsive layouts",
      "section": "Screens",
      "components": [
        {
          "componentId": "Inbox/Phone layout",
          "preview": "ThunderbirdInboxPhoneLayoutCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "Compact message-list layout on a phone."
        },
        {
          "componentId": "Inbox/Tablet layout",
          "preview": "ThunderbirdInboxTabletLayoutCatalogPreview",
          "select": {
            "size": "tabletLandscape"
          },
          "caption": "Expanded message-list layout on a landscape tablet."
        }
      ]
    },
    {
      "name": "Preferences",
      "section": "Screens",
      "components": [
        {
          "componentId": "Inbox/Display density",
          "preview": "ThunderbirdInboxDensityCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "Default, compact, and relaxed message-list density settings."
        },
        {
          "componentId": "Inbox/Footer behavior",
          "preview": "ThunderbirdInboxFooterCatalogPreview",
          "select": {
            "size": "phone"
          },
          "caption": "Message-list footer behavior under the supported preference combinations."
        }
      ]
    },
    {
      "name": "Dialogs",
      "section": "Components",
      "components": [
        {
          "componentId": "Archive folder/Setup dialog",
          "preview": "ThunderbirdArchiveFolderSetupCatalogPreview",
          "caption": "Cannot-archive, choose-folder, loading, populated-folder, and create-folder states."
        }
      ]
    }
  ]
}
